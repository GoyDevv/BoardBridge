<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      OpenGL ES 3.0 is the floor the bridge guarantees; it asks for ES 3.2, 3.1
      and 3.0 in turn (see docs/GRAPHICS.md). Claiming 3.2 as *required* here
      would exclude devices the bridge actually supports.
    -->
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <!-- Touch and gamepads are both optional: hardware keys and a mouse work too. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BoardBridge">

        <!--
          configChanges keeps the activity alive across rotation and keyboard
          changes; the SurfaceView's surface is still destroyed and recreated by
          the platform, which is exactly the lifecycle path the bridge is built
          around (docs/THREADING.md).
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|smallestScreenSize|uiMode|navigation|keyboard"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="userLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
